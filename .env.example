# ===================================================================
# Student Performance Predictor - Frontend Environment Configuration
# ===================================================================

# Optional: Full URL to your deployed Spring Boot Backend API
# When left blank or omitted, the frontend automatically runs in
# Intelligent Client AI mode with client-side inference and localStorage persistence.
#
# Examples for production on Vercel:
# VITE_API_BASE_URL=https://student-predictor-backend.onrender.com/api
# VITE_API_BASE_URL=https://my-backend.railway.app/api
#
# For local development with Spring Boot running on port 8080:
# VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_BASE_URL=
